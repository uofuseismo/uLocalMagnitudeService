#.rst
# FinduLocalMagnitude
# -------------------
#
# Finds the UUSS local magnitude calculator library.
#
# Imported Targets
# ^^^^^^^^^^^^^^^^
#
# ``uLocalMagnitude_FOUND``
#   True indicates uLocalMagnitude was found.
# ``uLocalMagnitude::uLocalMagnitude``
#   The local magnitude library, if found.
include(CMakeFindDependencyMacro)

find_dependency(TBB)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

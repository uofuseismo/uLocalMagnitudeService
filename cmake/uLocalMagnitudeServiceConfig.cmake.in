#.rst
# FinduLocalMagnitudeService
# -------------------
#
# Finds the UUSS local magnitude calculator library.
#
# Imported Targets
# ^^^^^^^^^^^^^^^^
#
# ``uLocalMagnitudeService_FOUND``
#   True indicates uLocalMagnitudeService was found.
# ``uLocalMagnitudeService::uLocalMagnitudeService``
#   The local magnitude library, if found.
include(CMakeFindDependencyMacro)

find_dependency(TBB)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
